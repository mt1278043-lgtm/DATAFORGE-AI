# ---------------------------------------------------------------------------
# DataForge AI — environment variables
# Copy this file to `.env.local` and fill in the values you need.
# The application runs fully in DEMO MODE when these are left empty.
# ---------------------------------------------------------------------------

# OpenAI (server-side only — never exposed to the browser).
# When empty, the AI Assistant, AI Insights narration and Report generator
# automatically fall back to the built-in deterministic Demo AI engine.
OPENAI_API_KEY=

# Optional: override the model used for AI features.
OPENAI_MODEL=gpt-4o-mini

# Supabase (optional — reserved for future persistence of datasets/reports).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app URL (used for metadata / share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
